# Local development (Docker Compose sets these itself)
DATABASE_URL=sqlite:///./platform.db
SECRET_KEY=generate_a_secure_random_string_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
FRONTEND_CORS_ORIGINS=http://localhost:3000
# Set to "production" in deployments (requires a strong SECRET_KEY)
ENVIRONMENT=development

# Optional: OpenAI for the AI assistant (otherwise rule-based answers)
OPENAI_API_KEY=

# Trading bot
BOT_ENABLED=true
MARKET_DATA_PROVIDER=mock          # mock (synthetic) or yfinance (live Yahoo Finance)
EXECUTION_MODE=exchange            # exchange (platform order book) or simulated
